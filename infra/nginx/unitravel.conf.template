# UniTravel behind the host nginx. Generated from infra/nginx/unitravel.conf.template by scripts/vps-deploy.sh;
# edit the template, not /etc/nginx/sites-available/unitravel.conf. Each "# --- host:" block is dropped until its
# certificate exists. Security headers (CSP with nonces, HSTS) are set by the apps themselves.

map $http_upgrade $connection_upgrade_ut { default upgrade; '' ''; }

server {
    listen 80;
    listen [::]:80;
    server_name ${WEB_HOST} ${ADMIN_HOST} ${DEV_HOST} ${MOBILE_HOST};
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://$host$request_uri; }
}

# --- host: ${WEB_HOST} (customer website / demo + pre-signed S3 uploads)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${WEB_HOST};
    ssl_certificate /etc/letsencrypt/live/${WEB_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${WEB_HOST}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    client_max_body_size 25m;
    gzip on; gzip_types text/css application/javascript application/json image/svg+xml;

    # Path-style buckets (unitravel-documents, -calls, -identity). The signature covers Host and path: pass both as is.
    location ^~ /unitravel-documents {
        proxy_pass http://127.0.0.1:${STORAGE_PORT};
        include snippets/unitravel-proxy.conf;
        proxy_request_buffering off;
        proxy_buffering off;
    }
    location / {
        proxy_pass http://127.0.0.1:${WEB_PORT};
        include snippets/unitravel-proxy.conf;
        proxy_buffering off;   # search progress streams over SSE through /api
        proxy_read_timeout 300s;
    }
}

# --- host: ${ADMIN_HOST} (Admin Panel)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${ADMIN_HOST};
    ssl_certificate /etc/letsencrypt/live/${ADMIN_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ADMIN_HOST}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    client_max_body_size 25m;
    gzip on; gzip_types text/css application/javascript application/json image/svg+xml;
    location / {
        proxy_pass http://127.0.0.1:${CONSOLE_PORT};
        include snippets/unitravel-proxy.conf;
        proxy_buffering off;
    }
}

# --- host: ${DEV_HOST} (Developer Panel; same console app, host-split by the app and the API)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DEV_HOST};
    ssl_certificate /etc/letsencrypt/live/${DEV_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DEV_HOST}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    client_max_body_size 25m;
    gzip on; gzip_types text/css application/javascript application/json image/svg+xml;
    location / {
        proxy_pass http://127.0.0.1:${CONSOLE_PORT};
        include snippets/unitravel-proxy.conf;
        proxy_buffering off;
    }
}

# --- host: ${MOBILE_HOST} (device-frame shell at /, Flutter web app at /app/, public API at /v1 and /health)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${MOBILE_HOST};
    ssl_certificate /etc/letsencrypt/live/${MOBILE_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MOBILE_HOST}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    client_max_body_size 25m;
    gzip on; gzip_types text/css application/javascript application/json application/wasm image/svg+xml;

    location /v1/ {
        proxy_pass http://127.0.0.1:${API_PORT};
        include snippets/unitravel-proxy.conf;
        proxy_buffering off;   # SSE search progress must not be buffered
        proxy_read_timeout 300s;
    }
    location = /health {
        proxy_pass http://127.0.0.1:${API_PORT};
        include snippets/unitravel-proxy.conf;
    }
    location / {
        proxy_pass http://127.0.0.1:${MOBILE_PORT};
        include snippets/unitravel-proxy.conf;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
}
