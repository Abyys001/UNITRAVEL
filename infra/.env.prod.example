# Production/staging environment for infra/compose.prod.yml. Copy to infra/.env.prod (git-ignored, chmod 600) and fill in.
#   cp infra/.env.prod.example infra/.env.prod && chmod 600 infra/.env.prod
# Never commit real values. Every CHANGE_ME must be replaced; see docs/runbooks/deploy-vps.md.

# staging | production. Deployed hosts use live data only and no demo users (ADR-0014); production refuses TEST_SIGN_IN=on (ADR-0012).
APP_ENV=staging
# Email-only test sign-in (ADR-0012). Staging may set "on" until real email (SMTP) is configured (owner, 27 Oct 2026); "off" otherwise. "on" is refused in production.
TEST_SIGN_IN=off
# Demo users are seeded only locally (ADR-0014): keep 0 on a deployed host.
SEED_DEMO=0

# --- Hosts: five DNS A records pointing at this server ---
WEB_HOST=app.example.com
API_HOST=api.example.com
ADMIN_HOST=admin.example.com
DEV_HOST=dev.example.com
MOBILE_HOST=m.example.com
# Browser-reachable object storage (pre-signed uploads). Leave OBJECT_STORAGE_PUBLIC_ENDPOINT unset to use it.
STORAGE_HOST=files.example.com
# Let's Encrypt registration / expiry notices
ACME_EMAIL=ops@example.com

# --- PostgreSQL (one password for the server, two for the app roles) ---
# Passwords: openssl rand -hex 24   (hex avoids URL-escaping problems)
# The owner role runs migrations; migrate.ts creates app_rw / app_ro (migration 0001) and sets the passwords given in
# DATABASE_URL / DATABASE_RO_URL, so choose them here and keep the URLs in step.
POSTGRES_USER=unitravel
POSTGRES_PASSWORD=CHANGE_ME_PG_OWNER
DATABASE_MIGRATE_URL=postgres://unitravel:CHANGE_ME_PG_OWNER@postgres:5432/unitravel
DATABASE_URL=postgres://app_rw:CHANGE_ME_APP_RW@postgres:5432/unitravel
DATABASE_RO_URL=postgres://app_ro:CHANGE_ME_APP_RO@postgres:5432/unitravel

# --- Auth and crypto (ch. 25) ---
# JWT_PRIVATE_KEY: Ed25519 PKCS#8 PEM on ONE line with literal \n separators:
#   openssl genpkey -algorithm ed25519 -out jwt.pem && awk 'NF {printf "%s\\n", $0}' jwt.pem   # then delete jwt.pem
# JWT_PUBLIC_KEYS: JSON array of public JWKs, first entry = the signing key; "x" is the raw public key, base64url:
#   openssl pkey -in jwt.pem -pubout -outform DER | tail -c 32 | basenc --base64url | tr -d '='
#   -> [{"kty":"OKP","crv":"Ed25519","x":"<that value>","kid":"k1"}]
# Rotation: add the new key FIRST in the array, keep the old one until its tokens expire.
JWT_PRIVATE_KEY='CHANGE_ME'
JWT_PUBLIC_KEYS='CHANGE_ME'
# Envelope-encryption master key (any string; the API hashes it with SHA-256): openssl rand -base64 32
# Losing it makes stored MFA secrets and provider credentials unreadable. Back it up separately.
MASTER_ENCRYPTION_KEY=CHANGE_ME
# OTP hashing pepper: openssl rand -base64 32
OTP_PEPPER=CHANGE_ME

# --- Object storage (RustFS service by default; SSE-S3 for identity scans, ADR-0005) ---
# Leave OBJECT_STORAGE_ENDPOINT unset to use the bundled `storage` service; set it to use a managed EU S3 endpoint.
# OBJECT_STORAGE_ENDPOINT=http://storage:9000
# Browser uploads use pre-signed URLs, so this must be reachable by browsers (e.g. a host routed to storage:9000, or the managed endpoint).
OBJECT_STORAGE_PUBLIC_ENDPOINT=
OBJECT_STORAGE_BUCKET=unitravel-documents
# openssl rand -hex 16 / openssl rand -hex 32
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
# Bundled storage only: openssl rand -base64 32
RUSTFS_SSE_S3_MASTER_KEY=CHANGE_ME

# --- Mail ---
# Real relay: smtp://user:pass@smtp.example.com:587   Staging sink: smtp://mailpit:1025 and start with --profile mail-sink
SMTP_URL=smtp://mailpit:1025

# --- Optional ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
