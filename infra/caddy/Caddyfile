# Edge (booklet ch. 30.2): TLS, HTTP/3, compression and the host split. Security headers are set by the apps
# (CSP needs a per-request nonce); Caddy only adds what applies to every response.
# No proxy sits in front of Caddy, so it trusts nobody's X-Forwarded-For: it replaces the header with the address it
# sees. (Trusting private ranges would let a client reaching Caddy through Docker's userland proxy, which shows up as
# a private bridge address, choose its own IP and slip past the per-IP limits.)
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header -Server
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header X-Content-Type-Options nosniff
	log {
		output stdout
		format json
	}
}

{$WEB_HOST} {
	import common
	# The site's /api proxy forwards this as the client address; it overwrites whatever the client sent.
	reverse_proxy web:4000 {
		header_up X-Real-IP {remote_host}
	}
}

{$API_HOST} {
	import common
	# SSE search progress must not be buffered.
	reverse_proxy api:4100 {
		flush_interval -1
	}
}

{$ADMIN_HOST}, {$DEV_HOST} {
	import common
	reverse_proxy console:4200 {
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}
}

{$MOBILE_HOST} {
	import common
	header X-Frame-Options DENY
	header Referrer-Policy strict-origin-when-cross-origin
	reverse_proxy mobile:80
}

# Pre-signed uploads and downloads go straight to object storage; the signature covers the Host header, which Caddy keeps.
# Only the application's buckets (path style) are reachable; the store's own console and admin API are not.
{$STORAGE_HOST} {
	import common
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	@buckets path /{$OBJECT_STORAGE_BUCKET:unitravel-documents} /{$OBJECT_STORAGE_BUCKET:unitravel-documents}/* /{$OBJECT_STORAGE_BUCKET:unitravel-documents}-identity/*
	handle @buckets {
		reverse_proxy storage:9000
	}
	handle {
		respond 404
	}
}
