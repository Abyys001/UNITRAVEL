{
  "name": "@unitravel/ui",
  "version": "1.0.0",
  "private": true,
  "description": "Shared React UI for web and console: kit shadcn/Base UI primitives restyled on UniTravel tokens + product components.",
  "exports": {
    "./styles.css": "./src/styles.css",
    "./components/*": "./src/components/*.tsx",
    "./product/*": "./src/product/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./brand/*": "./src/brand/*.tsx",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "tokens": "node scripts/gen-tokens.mjs",
    "tokens:check": "node scripts/gen-tokens.mjs --check",
    "test": "node --test scripts/tokens.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@unitravel/contracts": "workspace:*",
    "@unitravel/i18n": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "input-otp": "1.4.2",
    "lucide-react": "1.48.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
