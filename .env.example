# Local development (booklet ch. 36.3). Secrets below are local-only placeholders; production refuses defaults.
APP_ENV=local
DATABASE_URL=postgres://app_rw:app_rw_dev@localhost:5462/unitravel
DATABASE_MIGRATE_URL=postgres://unitravel:unitravel@localhost:5462/unitravel
DATABASE_APP_URL=postgres://app_rw:app_rw_dev@localhost:5462/unitravel
DATABASE_RO_URL=postgres://app_ro:app_ro_dev@localhost:5462/unitravel
REDIS_URL=redis://localhost:6390
OBJECT_STORAGE_ENDPOINT=http://localhost:9010
OBJECT_STORAGE_ACCESS_KEY=unitravel
OBJECT_STORAGE_SECRET_KEY=unitravel-secret
SMTP_URL=smtp://localhost:1035
PUBLIC_WEB_URL=http://localhost:4000
PUBLIC_CONSOLE_ADMIN_URL=http://admin.localhost:4200
PUBLIC_CONSOLE_DEV_URL=http://dev.localhost:4200
PUBLIC_MOBILE_WEB_URL=http://localhost:4300
PUBLIC_API_URL=http://localhost:4100
PORT=4100
LOG_LEVEL=info
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEYS / MASTER_ENCRYPTION_KEY / OTP_PEPPER: required in staging and production.
# Local SSE-S3 master key for the identity bucket (ADR-0005). Generate: openssl rand -base64 32
RUSTFS_SSE_S3_MASTER_KEY=
# ADR-0012: email-only test sign-in (off by default; refused when APP_ENV=production).
TEST_SIGN_IN=on

# ADR-0032 B1: Apify token, imported once into the encrypted provider store on API start when none is stored; remove it after import.
APIFY_TOKEN=
# ADR-0034: URL of the website revalidate route the API calls after a catalog refresh (e.g. http://localhost:4000/api/revalidate); unset = skip
WEB_REVALIDATE_URL=

# Shared secret the API sends (x-revalidate-secret) to POST /api/revalidate on the web app after a catalog refresh; unset = route disabled
WEB_REVALIDATE_SECRET=
